{
  "expo": {
    "name": "Hybrid.App",
    "slug": "hybrid-app",
    "version": "0.6.0",
    "scheme": "hybrid",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hybridapp.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Hybrid.App utilise ta position pendant tes activités pour tracer ton parcours et permettre le suivi Live que tu actives."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.hybridapp.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash.png"
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Hybrid.App utilise ta position uniquement pendant une activité Live ou GPS afin de tracer ton parcours."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Autoriser Hybrid à suivre votre parcours pendant une activité Live."
        }
      ]
    ],
    "updates": {
      "enabled": false,
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "web": {
      "output": "single",
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
