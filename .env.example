EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# V4 integrations — optional until you connect the providers.
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=YOUR_SPOTIFY_CLIENT_ID
EXPO_PUBLIC_STRAVA_CLIENT_ID=YOUR_STRAVA_CLIENT_ID

# Keep client secrets and provider refresh tokens on the server / Supabase Edge Functions.
# Never expose Spotify, Strava, Garmin or other provider secrets with EXPO_PUBLIC_*.
